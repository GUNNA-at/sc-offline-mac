+
+static std::atomic<uint32_t> _mvkLiveBits{0};
+static std::atomic<uint64_t> _mvkLiveNextCheck{0};
+static std::atomic<uint64_t> _mvkLiveNextReport{0};
+static std::atomic<uint32_t> _mvkLiveCounters[kMVKLiveCounterCount];
+
+static void mvkLiveRefresh(uint64_t now) {
+	static const char* names[kMVKLiveSwitchCount] = { "tess-prepass", "async-submit" };
+	static const char* envs[kMVKLiveSwitchCount] = { "MVK_SC_TESS_PREPASS", "MVK_SC_ASYNC_SUBMIT" };
+	uint32_t bits = 0;
+	for (uint32_t i = 0; i < kMVKLiveSwitchCount; i++) {
+		char path[96];
+		struct stat st;
+		const char* env = getenv(envs[i]);
+		bool on = env && env[0] == '1';
+		snprintf(path, sizeof(path), "/private/tmp/mvk-live/%s", names[i]);
+		if (stat(path, &st) == 0) { on = true; }
+		snprintf(path, sizeof(path), "/private/tmp/mvk-live/no-%s", names[i]);
+		if (stat(path, &st) == 0) { on = false; }
+		if (on) { bits |= 1u << i; }
+	}
+	_mvkLiveBits.store(bits, std::memory_order_relaxed);
+
+	uint64_t report = _mvkLiveNextReport.load(std::memory_order_relaxed);
+	if (now >= report && _mvkLiveNextReport.compare_exchange_strong(report, now + 5000000000ull)) {
+		uint32_t c[kMVKLiveCounterCount];
+		for (uint32_t i = 0; i < kMVKLiveCounterCount; i++) { c[i] = _mvkLiveCounters[i].exchange(0, std::memory_order_relaxed); }
+		if (c[kMVKLiveCounterTessDraws] || c[kMVKLiveCounterAsyncSubmits]) {
+			fprintf(stderr, "[mvk-live] last 5 s: %u tessellated draws, %u render pass restarts for them, %u command buffer splits, %u async submits | tess-prepass %s, async-submit %s\n",
+					c[kMVKLiveCounterTessDraws], c[kMVKLiveCounterTessRestarts], c[kMVKLiveCounterTessSplits], c[kMVKLiveCounterAsyncSubmits],
+					(bits & (1u << kMVKLiveSwitchTessPrepass)) ? "on" : "off", (bits & (1u << kMVKLiveSwitchAsyncSubmit)) ? "on" : "off");
+		}
+	}
+}
+
+bool mvkLiveSwitch(MVKLiveSwitch sw) {
+	uint64_t now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+	uint64_t next = _mvkLiveNextCheck.load(std::memory_order_relaxed);
+	if (now >= next && _mvkLiveNextCheck.compare_exchange_strong(next, now + 1000000000ull)) { mvkLiveRefresh(now); }
+	return (_mvkLiveBits.load(std::memory_order_relaxed) >> sw) & 1u;
+}
+
+void mvkLiveCount(MVKLiveCounter counter) { _mvkLiveCounters[counter].fetch_add(1, std::memory_order_relaxed); }
 
