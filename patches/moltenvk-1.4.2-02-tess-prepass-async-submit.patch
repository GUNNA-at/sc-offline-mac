+#pragma mark Tessellation compute ahead of the render pass
+
+// Metal has no tessellation shaders: the vertex and tessellation-control stages of a tessellated draw run as compute,
+// and compute cannot run inside a Metal render pass. The stock path therefore ends the render pass before every
+// tessellated draw and starts it again afterwards, and a tile-based GPU stores and reloads every attachment each time.
+//
+// Here the compute stages go to a MTLCommandBuffer of their own that is queued ahead of the one carrying the render
+// pass, so the pass is interrupted once, at its first tessellated draw, instead of once per draw. Everything encoded
+// before that first draw is committed first, so the compute work still runs after it. Within one render pass nothing
+// can be written between two draws that a vertex or tessellation-control stage of a later draw may read, which is
+// what makes it sound to run the pass's later compute work before its earlier draws.
+bool MVKCommandEncoder::beginTessellatedDraw(bool canRunAhead) {
+	mvkLiveCount(kMVKLiveCounterTessDraws);
+	_isEncodingTessPrepass = false;
+	if ( !(canRunAhead && _cmdBuffSubmit && mvkLiveSwitch(kMVKLiveSwitchTessPrepass)) ||
+		isUsingMetalArgumentBuffers() || _cmdBuffer->_hasStageCounterTimestampCommand ||
+		(getSubpass() && getSubpass()->isMultiview()) ) {
+		mvkLiveCount(kMVKLiveCounterTessRestarts);
+		return false;
+	}
+	if ( !_tessPrepassValid ) {
+		if (_mtlRenderEncoder) { encodeStoreActions(true); }
+		endCurrentMetalEncoding();
+		closeTessellationPrepass();
+		_mtlTessCmdBuffer = _cmdBuffSubmit->beginPrepassMTLCommandBuffer();		// retained for us
+		_mtlCmdBuffer = _cmdBuffSubmit->getActiveMTLCommandBuffer();			// not retained
+		_cmdBuffer->setMetalObjectLabel(_mtlCmdBuffer, _cmdBuffer->_debugName);
+		_mtlTessEncoder = [[_mtlTessCmdBuffer computeCommandEncoderWithDispatchType: MTLDispatchTypeSerial] retain];
+		_cmdBuffer->setMetalObjectLabel(_mtlTessEncoder, mvkMTLComputeCommandEncoderLabel(kMVKCommandUseTessellationVertexTessCtl));
+		_tessPrepassValid = (_mtlTessEncoder != nil);
+		mvkLiveCount(kMVKLiveCounterTessSplits);
+		mvkLiveCount(kMVKLiveCounterTessRestarts);
+		if ( !_tessPrepassValid ) { closeTessellationPrepass(); return false; }
+	}
+	_isEncodingTessPrepass = true;
+	getState().beginComputeEncoding();		// as for a new compute encoder: nothing is taken to be bound on it
+	return true;
+}
+
+id<MTLComputeCommandEncoder> MVKCommandEncoder::getMTLTessComputeEncoder() {
+	return _isEncodingTessPrepass ? _mtlTessEncoder : getMTLComputeEncoder(kMVKCommandUseTessellationVertexTessCtl);
+}
+
+void MVKCommandEncoder::endTessellationCompute() {
+	if (_isEncodingTessPrepass) {
+		_isEncodingTessPrepass = false;
+		if (_mtlRenderEncoder) {
+			getState().resumeGraphicsEncoding();	// the render pass was never interrupted
+			return;
+		}
+	}
+	// Running the compute stages ended the Metal render pass, so start it up again.
+	beginMetalRenderPass(kMVKCommandUseRestartSubpass);
+}
+
+void MVKCommandEncoder::endTessellatedDraw() {
+	if (_isEncodingTessPrepass) {
+		_isEncodingTessPrepass = false;
+		if (_mtlRenderEncoder) { getState().resumeGraphicsEncoding(); }
+	}
+}
+
+// Ends and commits the tessellation MTLCommandBuffer. It sits ahead of the current MTLCommandBuffer in the queue,
+// so it has to be committed before that one can run.
+void MVKCommandEncoder::closeTessellationPrepass() {
+	_isEncodingTessPrepass = false;
+	_tessPrepassValid = false;
+	if (_mtlTessEncoder) {
+		[_mtlTessEncoder endEncoding];
+		[_mtlTessEncoder release];
+		_mtlTessEncoder = nil;
+	}
+	if (_mtlTessCmdBuffer) {
+		[_mtlTessCmdBuffer commit];
+		[_mtlTessCmdBuffer release];
+		_mtlTessCmdBuffer = nil;
+	}
+}
